<Window x:Class="BabisW.InjectionToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        Height="88"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border Background="#FF181818"
            BorderBrush="#FF303030"
            BorderThickness="1"
            CornerRadius="2"
            Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="44"
                   Height="44"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Source="/Babis-WIcon.png"
                   Stretch="Uniform"/>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0">
                <TextBlock Text="Babis"
                           Foreground="White"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock Text="[Attached]"
                           Foreground="#FFB8B8B8"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
